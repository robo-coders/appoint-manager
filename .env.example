# The name people read: the wordmark, page titles, email footers, the invoice
# line item. One key, and `config/product.php` is the only place it is written.
PRODUCT_NAME=DiaryDesk

# The name machines are called, which is a different thing. Laravel slugs this
# into the cache and Redis prefixes, and App\Support\Surface slugs it into the
# three session cookie names — so changing it signs out every logged-in
# operator and cold-starts the cache. It stays as the repository is named until
# the repository, database and package are renamed together. See DECISIONS.md.
APP_NAME="Appoint Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# `php artisan serve` (and `composer dev`) binds 127.0.0.1:8000. Route URLs are
# generated from APP_URL, so a value without the port makes every generated
# link point at port 80 and 404 in the browser.
APP_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Surfaces
# ---------------------------------------------------------------------------
# Appoint Manager is one app served from four hostnames. Leave these unset and
# every surface is served from APP_URL on a path prefix instead (/, /diary,
# /book/{slug}, /admin) so nothing has to be added to /etc/hosts. See DEPLOY.md.
#
# They are commented out rather than left blank on purpose: a blank value is a
# value, and `config/app.php` has to defend against it. Uncomment and fill all
# five together when you move to real hostnames.
# APP_DOMAIN=appoint-manager.com
# SUBDOMAIN_ROUTING=true
# APP_URL_MARKETING=https://appoint-manager.com
# APP_URL_APP=https://app.appoint-manager.com
# APP_URL_BOOK=https://book.appoint-manager.com
# APP_URL_ADMIN=https://admin.appoint-manager.com

# Comma-separated IPs or CIDR ranges permitted to reach admin.{domain}.
# Empty means no restriction, which is right locally and wrong in production.
ADMIN_IP_ALLOWLIST=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Production: json (30-day daily files, tenant_id on every line)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=appoint_manager
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The Vite dev server. `npm run dev` serves assets from its OWN origin — this
# host and port — while the pages come from APP_URL, so the two are different
# origins and the CSP has to be told about this one. `vite.config.js` reads
# these and derives `server.origin` from them; nothing in PHP restates the
# port. Change them here and both sides follow. See README.
VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173

# Connect — salon deposits, Stripe-Account header. Endpoint: /stripe/webhook
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Platform subscriptions on our Stripe account. Endpoint: /stripe/billing/webhook
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

SMS_DRIVER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_STATUS_URL=

# Inbound STOP and the delivery callback are signature-verified whenever
# TWILIO_TOKEN is set. Only turn this off to isolate a tunnel URL mismatch.
TWILIO_VERIFY_SIGNATURE=true

# Your own mobile, for `php artisan demo:rebooking`. The one seeded number that
# is real, so a rebooking text can be read on a handset before a customer gets
# one. Local only. See DEPLOY.md.
REBOOKING_DEMO_PHONE=

# Privacy-respecting analytics. Empty disables the script.
PLAUSIBLE_DOMAIN=

# Errors. Tenant ID is tagged when a tenant context exists.
SENTRY_LARAVEL_DSN=

HORIZON_PREFIX=appoint-manager-horizon
