APP_NAME=Kestrel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ---------------------------------------------------------------------------
# Surfaces
# ---------------------------------------------------------------------------
# Kestrel is one app served from four hostnames. Leave APP_DOMAIN empty and
# every surface is served from APP_URL on a path prefix instead (/, /diary,
# /book/{slug}, /admin) so nothing has to be added to /etc/hosts. See DEPLOY.md.
APP_DOMAIN=
SUBDOMAIN_ROUTING=

APP_URL_MARKETING=
APP_URL_APP=
APP_URL_BOOK=
APP_URL_ADMIN=

# Comma-separated IPs or CIDR ranges permitted to reach admin.{domain}.
# Empty means no restriction, which is right locally and wrong in production.
ADMIN_IP_ALLOWLIST=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Production: json (30-day daily files, tenant_id on every line)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kestrel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Connect — salon deposits, Stripe-Account header. Endpoint: /stripe/webhook
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Platform subscriptions on our Stripe account. Endpoint: /stripe/billing/webhook
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

SMS_DRIVER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_STATUS_URL=

# Privacy-respecting analytics. Empty disables the script.
PLAUSIBLE_DOMAIN=

# Errors. Tenant ID is tagged when a tenant context exists.
SENTRY_LARAVEL_DSN=

HORIZON_PREFIX=kestrel-horizon
